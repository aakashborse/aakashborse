{
  "_comment": "EnergeX — Commercial Building with TOU Tariff + Demand Charges (Phase C example)",

  "name": "Commercial Building — TOU + Demand Charges",
  "project_lifetime_years": 25,
  "discount_rate_pct": 10.0,
  "simulation_year": 2025,

  "load": {
    "mode": "simple",
    "avg_kw": 120.0,
    "peak_kw": 180.0,
    "critical_fraction": 0.35
  },

  "outage": {
    "mode": "stochastic",
    "stochastic": {
      "saidi_minutes_per_year": 1200.0,
      "saifi_events_per_year": 15.0,
      "duration_distribution": "lognormal",
      "duration_sigma": 0.8,
      "monthly_weights": [1.0, 1.0, 1.0, 1.2, 1.4, 2.0, 2.8, 2.8, 1.8, 1.2, 1.0, 1.0]
    }
  },

  "grid": {
    "_comment_tou": "Indian 3-tier TOU: peak 0800-2200 weekdays, off-peak otherwise. Demand charge ₹300/kW/month with 80% ratchet — typical for Maharashtra HT consumer.",
    "energy_rate_rs_kwh": 7.50,
    "fixed_charge_rs_month": 2000.0,
    "escalation_pct_yr": 5.5,

    "tou_blocks": [
      {
        "name": "peak",
        "rate_rs_kwh": 9.50,
        "start_hour": 8,
        "end_hour": 22,
        "day_type": "weekday"
      },
      {
        "name": "shoulder",
        "rate_rs_kwh": 7.50,
        "start_hour": 6,
        "end_hour": 22,
        "day_type": "weekend"
      },
      {
        "name": "off_peak",
        "rate_rs_kwh": 5.50,
        "start_hour": 22,
        "end_hour": 6,
        "day_type": "all"
      }
    ],

    "demand_charge": {
      "_comment": "₹300/kW/month on monthly peak demand. 80% ratchet — bill cannot drop below 80% of annual peak. Contracted demand 100 kW (floor).",
      "charge_rs_kw_month": 300.0,
      "ratchet_pct": 80.0,
      "contracted_demand_kw": 100.0
    }
  },

  "bess": {
    "capacity_kwh": 200.0,
    "power_kw": 100.0,
    "dod_pct": 90.0,
    "roundtrip_efficiency": 0.92,
    "min_reserve_soc_pct": 10.0,
    "initial_soc_pct": 90.0,
    "calendar_fade_pct_yr": 2.0,
    "cycle_fade_per_kwh": 0.000025,
    "calendar_life_yr": 12.0,
    "eol_capacity_pct": 80.0,
    "capex_rs_kwh": 35000.0,
    "replacement_cost_fraction": 0.6,
    "om_rs_kwh_yr": 500.0,
    "availability_pct": 99.0
  },

  "outage_cost": {
    "mode": "voll",
    "voll_rs_kwh": 150.0,
    "sla_max_downtime_hrs_yr": 4.0,
    "sla_max_ens_kwh_yr": 200.0,
    "sla_continuity_pct": 99.9,
    "sla_min_autonomy_hours": 2.0
  },

  "monte_carlo": {
    "n_trials": 200,
    "confidence_levels": [0.10, 0.50, 0.90, 0.99]
  },

  "sizing": {
    "bess_sizes_kwh": [0, 100, 150, 200, 250, 300],
    "dg_sizes_kw": [0, 100, 150],
    "bess_power_ratio": 0.5,
    "optimize_for": "incremental_npv",
    "require_sla_pass": true
  }
}
